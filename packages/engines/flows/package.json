{
  "name": "@rivet/engine-flows",
  "version": "0.1.0",
  "description": "Flow testing analysis engine for RIVET",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --tsconfig ../../../tsconfig.tsup.json",
    "dev": "tsup --tsconfig ../../../tsconfig.tsup.json --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src"
  },
  "dependencies": {
    "@rivet/core": "workspace:*",
    "@rivet/parsers": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
