{
  "name": "@rivet/ai",
  "version": "0.1.0",
  "description": "AI-powered code quality explanations and suggestions",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external @rivet/core --external langchain --external @langchain/openai",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external @rivet/core --external langchain --external @langchain/openai",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@langchain/core": "^0.3.29",
    "@langchain/openai": "^1.2.13",
    "@rivet/core": "workspace:*",
    "langchain": "^0.3.7"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.1.0"
  }
}
