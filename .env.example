# Optional OpenAI configuration. A key alone does not enable provider requests.
# CLI: export variables, or use node --env-file=.env.local explicitly from the repo root.
# Web: export variables before starting Next.js, or use apps/web/.env.local.
# Do not commit real keys. Only OpenAI is wired; no provider-selector setting exists.
OPENAI_API_KEY=
# Optional override; otherwise packages/core/src/models.ts provides the default.
# OPENAI_MODEL=your-model-id
