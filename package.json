{
  "name": "rivet",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered code quality platform for modern development teams",
  "keywords": [
    "code-quality",
    "static-analysis",
    "security",
    "linting",
    "refactoring",
    "ai",
    "developer-tools"
  ],
  "homepage": "https://github.com/forbiddenlink/rivet#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/forbiddenlink/rivet.git"
  },
  "license": "MIT",
  "author": {
    "name": "Elizabeth Stein",
    "url": "https://github.com/forbiddenlink"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:first-run": "node scripts/check-first-run.cjs",
    "test:watch": "turbo run test:watch",
    "lint": "biome check . && node scripts/check-no-stray-build-output.mjs",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "format:check": "biome format . --check",
    "typecheck": "turbo run typecheck",
    "complexity": "fta .",
    "complexity:packages": "fta packages",
    "complexity:json": "fta . --json > complexity-report.json",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "check:stray": "node scripts/check-no-stray-build-output.mjs",
    "clean:stray": "find apps packages -path '*/src/*' \\( -name '*.js' -o -name '*.js.map' -o -name '*.d.ts' -o -name '*.d.ts.map' \\) -not -path '*/node_modules/*' -not -name 'next-env.d.ts' -delete"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@types/node": "20.19.43",
    "fta-cli": "3.1.0",
    "tsup": "8.5.1",
    "turbo": "2.11.8",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "vite": "8.3.4"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "@isaacs/brace-expansion": ">=5.0.1 <6.0.0",
      "flatted": ">=3.4.2 <4.0.0",
      "picomatch": ">=4.0.4 <5.0.0",
      "postcss": ">=8.5.3 <9.0.0",
      "rollup": ">=4.59.0 <5.0.0",
      "semver": ">=7.7.2 <8.0.0",
      "tar": ">=7.7.0 <8.0.0",
      "vite": ">=8.2.4 <9.0.0",
      "ws": ">=8.18.2 <9.0.0",
      "yaml": ">=2.8.3 <3",
      "langsmith": ">=0.7.2 <0.12.0",
      "minimatch": ">=10.2.5 <11.0.0",
      "turbo": ">=2.5.10 <3.0.0",
      "uuid": ">=11.1.1 <12.0.0",
      "sharp": ">=0.35.0 <1",
      "js-yaml": ">=4.3.1 <5",
      "brace-expansion@1": ">=1.1.21 <2",
      "brace-expansion@2": ">=2.1.7 <3",
      "brace-expansion@5": ">=5.0.12 <6",
      "shell-quote": ">=1.11.0 <2",
      "source-map-js@1": ">=1.2.2 <2.0.0"
    }
  }
}
