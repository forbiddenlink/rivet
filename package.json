{
  "name": "rivet",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered code quality platform for modern development teams",
  "keywords": [
    "code-quality",
    "static-analysis",
    "security",
    "linting",
    "refactoring",
    "ai",
    "developer-tools"
  ],
  "homepage": "https://github.com/elizabethstein/rivet#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/elizabethstein/rivet.git"
  },
  "license": "MIT",
  "author": {
    "name": "Elizabeth Stein",
    "email": "elizabeth@example.com"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "format:check": "biome format . --check",
    "typecheck": "turbo run typecheck",
    "complexity": "fta .",
    "complexity:packages": "fta packages",
    "complexity:json": "fta . --json > complexity-report.json",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^20.11.0",
    "fta-cli": "^3.0.0",
    "tsup": "^8.0.1",
    "turbo": "^2.10.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vite": "^8.0.16"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "@isaacs/brace-expansion": ">=5.0.1",
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.3",
      "rollup": ">=4.59.0",
      "semver": ">=7.7.2",
      "tar": ">=7.7.0",
      "vite": ">=8.0.16 <9",
      "ws": ">=8.18.2",
      "yaml": ">=2.8.0",
      "langsmith": ">=0.7.2",
      "minimatch": ">=10.2.5",
      "turbo": ">=2.5.10",
      "uuid": ">=11.1.1",
      "brace-expansion": ">=5.0.8 <6",
      "sharp": ">=0.35.0 <1"
    }
  }
}
