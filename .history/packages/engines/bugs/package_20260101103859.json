{
  "name": "@rivet/engine-bugs",
  "version": "0.1.0",
  "description": "Bug detection engine for RIVET",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external @rivet/core --external @rivet/parsers --external typescript",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rivet/core": "workspace:*",
    "@rivet/parsers": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  },
  "keywords": ["bugs", "errors", "null-checks", "promises", "analysis"],
  "author": "",
  "license": "MIT"
}
