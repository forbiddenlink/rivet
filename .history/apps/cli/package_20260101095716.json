{
  "name": "@rivet/cli",
  "version": "0.1.0",
  "description": "Command-line interface for RIVET code quality analysis",
  "bin": {
    "rivet": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts --clean",
    "dev": "tsup src/index.ts --format cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@rivet/core": "workspace:*",
    "@rivet/parsers": "workspace:*",
    "chalk": "^4.1.2",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "cli",
    "code-quality",
    "linting"
  ]
}
